      "id": "gcf-p01",
      "type": "mcq",
      "prompt": "Which one is a <b>monomial</b>?",
      "figure": {
        "alt": "Example: the monomial 4a squared b drawn as tiles 2, 2, a, a, b. One term, so no plus or minus signs.",
        "chips": {
          "groups": [
            {
              "items": [
                "2",
                "2",
                "a",
                "a",
                "b"
