{
  "id": "makeup-linear-forms",
  "title": "Prep: 3 Forms of Linear Equations",
  "description": "Focused prep for the 3 Forms of Linear Equations make-up quiz: slope-intercept, standard, and point-slope form. Find slope and intercepts, convert between forms, and write lines from a point, two points, or a graph.",
  "strand": "makeup",
  "status": "starter",
  "related": ["linear", "parallel-perpendicular"],
  "reference": {
    "title": "The 3 forms",
    "rows": [
      { "label": "Slope-intercept", "rule": "y = mx + b", "note": "m = slope, b = y-intercept" },
      { "label": "Standard", "rule": "Ax + By = C", "note": "slope = −A/B" },
      {
        "label": "Point-slope",
        "rule": "y − y<sub>1</sub> = m(x − x<sub>1</sub>)",
        "note": "point (x<sub>1</sub>, y<sub>1</sub>)"
      }
    ],
    "foot": "Slope from two points: m = (y<sub>2</sub> − y<sub>1</sub>) / (x<sub>2</sub> − x<sub>1</sub>)."
  },
