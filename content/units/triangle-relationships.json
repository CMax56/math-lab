    {
      "id": "tri-p06",
      "type": "mcq",
      "prompt": "Which set of side lengths can make a triangle?",
      "figure": {
        "alt": "A triangle with sides labeled a, b, and c.",
        "pts": [
          { "id": "A", "x": 6.0, "y": 196.8, "name": "A" },
          { "id": "B", "x": 324.0, "y": 196.8, "name": "B" },
          { "id": "C", "x": 117.3, "y": 6.0, "name": "C" }
