    {
      "id": "tri-fc06",
      "front": "Altitude and orthocenter",
      "back": "An altitude goes from a vertex to the opposite side (or its extension) at a right angle. The altitudes meet at the <b>orthocenter</b>."
    },
    {
      "id": "tri-fc07",
      "front": "Midsegment Theorem",
      "back": "A segment joining the midpoints of two sides is <b>parallel</b> to the third side and <b>half</b> as long."
    },
    {
      "id": "tri-fc08",
      "front": "Triangle Inequality",
      "back": "Any two sides must add to <b>more than</b> the third side. If the sides are a and b, the third side is between |a − b| and a + b."
    },
    { "id": "tri-fc09", "front": "Triangle Angle Sum", "back": "The three angles of a triangle add to <b>180°</b>." },
    {
      "id": "tri-fc10",
      "front": "Exterior Angle Theorem",
      "back": "An exterior angle equals the sum of the two remote (non-adjacent) interior angles."
    },
    {
      "id": "tri-fc11",
      "front": "Sides and angles",
      "back": "The longest side is across from the largest angle. The shortest side is across from the smallest angle."
    },
    {
      "id": "tri-fc12",
      "front": "Which center?",
      "back": "Circumcenter: perpendicular bisectors, equal distance to vertices. Incenter: angle bisectors, equal distance to sides. Centroid: medians, balance point. Orthocenter: altitudes."
    }
