    },
    {
      "id": "tri-fc03",
      "front": "Angle bisector",
      "back": "A ray that splits an angle into two equal angles. Every point on it is the same distance from the two sides of the angle."
    },
    {
      "id": "tri-fc04",
      "front": "Incenter",
      "back": "Where the three angle bisectors meet. It is the same distance from all three <b>sides</b> (center of the circle inside the triangle)."
    },
