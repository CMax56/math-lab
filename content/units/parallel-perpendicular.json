    {
      "id": "par-fc02",
      "front": "Corresponding angles",
      "back": "Same position at each crossing (like ∠2 and ∠6). Parallel lines → <b>congruent</b>."
    },
    {
      "id": "par-fc03",
      "front": "Alternate interior angles",
      "back": "Between the lines, on opposite sides of the transversal (like ∠3 and ∠6). Parallel lines → <b>congruent</b>."
    },
    {
      "id": "par-fc04",
      "front": "Alternate exterior angles",
      "back": "Outside the lines, on opposite sides of the transversal (like ∠1 and ∠8). Parallel lines → <b>congruent</b>."
    },
    {
      "id": "par-fc05",
      "front": "Same-side interior angles",
      "back": "Between the lines, on the same side of the transversal (like ∠3 and ∠5). Parallel lines → <b>supplementary</b> (add to 180°). Also called consecutive interior angles."
    },
    {
      "id": "par-fc06",
      "front": "Proving lines parallel (converses)",
      "back": "If corresponding, alternate interior, or alternate exterior angles are congruent, or same-side interior angles are supplementary, then the lines are parallel."
    },
    {
      "id": "par-fc07",
      "front": "Slopes of parallel lines",
      "back": "Parallel (non-vertical) lines have <b>equal slopes</b>. Example: y = 2x + 1 and y = 2x − 7."
    },
    {
      "id": "par-fc08",
      "front": "Slopes of perpendicular lines",
      "back": "<b>Negative reciprocals</b>: flip and change the sign. The slopes multiply to −1. Example: 2/3 and −3/2."
    },
    {
      "id": "par-fc09",
      "front": "Point-slope form",
      "back": "y − y₁ = m(x − x₁). Use it to write a line through a point (x₁, y₁) with slope m."
    },
    {
      "id": "par-fc10",
      "front": "Horizontal and vertical lines",
      "back": "Horizontal: y = k, slope 0. Vertical: x = k, slope undefined. A horizontal and a vertical line are perpendicular."
    },
    {
      "id": "par-fc11",
      "front": "Perpendicular Transversal Theorem",
      "back": "If a line is perpendicular to one of two parallel lines, it is perpendicular to the other one too."
    }
  ],
