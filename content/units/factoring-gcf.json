{
  "id": "factoring-gcf",
  "title": "Factoring Out a Monomial (GCF)",
  "description": "Find the greatest common factor (GCF) of the terms, pull it out in front of parentheses, and check by distributing. Covers monomials, the GCF of numbers and of variables (lowest exponent), factoring out a negative, and the two big mistakes: forgetting the 1 and not taking the full GCF.",
  "strand": "algebra",
  "status": "starter",
  "reference": {
    "title": "Factoring out the GCF",
    "rows": [
      {
        "label": "Monomial",
        "rule": "one term: a number, variables, or both",
        "note": "5, x, −3x<sup>2</sup>y"
      },
      {
        "label": "1. Numbers",
        "rule": "GCF of the coefficients",
        "note": "6 and 9 → 3"
      },
      {
        "label": "2. Variables",
        "rule": "<b>lowest</b> exponent of each shared variable",
        "note": "x<sup>2</sup> and x → x"
      },
      {
        "label": "3. Divide",
        "rule": "divide every term by the GCF",
        "note": "6x<sup>2</sup> ÷ 3x = 2x, 9x ÷ 3x = 3"
      },
      {
        "label": "4. Write",
        "rule": "6x<sup>2</sup> + 9x = 3x(2x + 3)"
      },
      {
        "label": "5. Check",
        "rule": "distribute: 3x · 2x + 3x · 3 = 6x<sup>2</sup> + 9x"
      }
    ],
    "foot": "If a whole term is the GCF, leave a 1: 4x + 4 = 4(x + 1). If the first term is negative, you can take out −GCF and flip every sign inside."
  },
  "practice": [
