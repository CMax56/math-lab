        "polys": [["A", "B", "C"]],
        "segs": [{ "a": "B", "b": "C", "text": "a" }, { "a": "C", "b": "A", "text": "b" }, { "a": "A", "b": "B", "text": "c" }],
        "angles": []
      },
      "choices": ["3, 4, 8", "5, 6, 12", "4, 7, 10", "2, 9, 11"],
      "answer": "4, 7, 10",
      "acceptable": [],
      "hints": [
        "Triangle Inequality: the two shorter sides must add up to <b>more than</b> the longest side.",
        "Test each set: add the two smaller numbers and compare with the biggest.",
        "Exactly equal is not enough: the sides would lie flat."
      ],
      "solution": "3 + 4 = 7 &lt; 8 ✗ · 5 + 6 = 11 &lt; 12 ✗ · <b>4 + 7 = 11 &gt; 10 ✓</b> · 2 + 9 = 11, not more than 11 ✗"
    },
