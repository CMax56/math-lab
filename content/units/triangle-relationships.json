  "practice": [
    {
      "id": "tri-p01",
      "type": "numeric",
      "prompt": "In △ABC, m∠A = 48° and m∠B = 67°. Find m∠C.",
      "figure": {
        "alt": "Triangle ABC with angle A 48 degrees, angle B 67 degrees, and angle C marked x.",
        "pts": [
          { "id": "A", "x": 6.0, "y": 246.0, "name": "A" },
          { "id": "B", "x": 324.0, "y": 246.0, "name": "B" },
          { "id": "C", "x": 222.1, "y": 6.0, "name": "C" }
        ],
        "polys": [["A", "B", "C"]],
        "segs": [{ "a": "A", "b": "B" }, { "a": "B", "b": "C" }, { "a": "C", "b": "A" }],
        "angles": [
          { "at": "A", "a": "B", "b": "C", "text": "48°" },
          { "at": "B", "a": "A", "b": "C", "text": "67°" },
          { "at": "C", "a": "A", "b": "B", "text": "x", "ask": true, "deg": 65 }
        ]
      },
      "answer": "65",
      "acceptable": [],
      "check": "180 - 48 - 67",
      "hints": ["The three angles of any triangle add to 180°.", "48 + 67 + x = 180.", "48 + 67 = 115. Subtract from 180."],
      "solution": "48 + 67 + x = 180<br>115 + x = 180<br>x = <b>65°</b>"
    },
    {
