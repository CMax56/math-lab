  "flashcards": [
    { "id": "sim-fc01", "front": "Similar figures", "back": "Same shape, possibly different size. Corresponding angles are congruent and corresponding sides are proportional. Symbol: ∼" },
    { "id": "sim-fc02", "front": "Scale factor (k)", "back": "new length ÷ original length. k &gt; 1 enlarges; 0 &lt; k &lt; 1 shrinks." },
    { "id": "sim-fc03", "front": "AA similarity", "back": "If two pairs of angles are congruent, the triangles are similar." },
    { "id": "sim-fc04", "front": "SSS similarity (SSS~)", "back": "If all three pairs of sides have the same ratio, the triangles are similar." },
    { "id": "sim-fc05", "front": "SAS similarity (SAS~)", "back": "If two pairs of sides have the same ratio and the included angles are congruent, the triangles are similar." },
    { "id": "sim-fc06", "front": "Triangle Proportionality Theorem", "back": "A line parallel to one side of a triangle divides the other two sides proportionally." },
    { "id": "sim-fc07", "front": "Dilation centered at the origin", "back": "(x, y) → (kx, ky). Multiply both coordinates by the scale factor k." },
    { "id": "sim-fc08", "front": "Perimeter of similar figures", "back": "Perimeter ratio = k (same as the side ratio)." },
    { "id": "sim-fc09", "front": "Area of similar figures", "back": "Area ratio = k². Example: k = 3 → area is 9 times as big." },
    { "id": "sim-fc10", "front": "Volume of similar solids", "back": "Volume ratio = k³. Example: k = 2 → volume is 8 times as big." },
    { "id": "sim-fc11", "front": "Cross-multiplying", "back": "If a/b = c/d, then a·d = b·c. Use it to solve proportions." }
  ],
