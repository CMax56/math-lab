  "practice": [
    {
      "id": "sim-p01",
      "type": "numeric",
      "prompt": "△ABC ∼ △DEF with AB = 6 and DE = 15. What is the scale factor from △ABC to △DEF?",
      "figure": {
        "alt": "Similar triangles ABC and DEF. AB is 6 and the corresponding side DE is 15.",
        "pts": [
          { "id": "B", "x": 6.0, "y": 189.9, "name": "B" },
          { "id": "C", "x": 81.2, "y": 189.9, "name": "C" },
          { "id": "A", "x": 52.0, "y": 116.3, "name": "A" },
          { "id": "E", "x": 136.1, "y": 189.9, "name": "E" },
          { "id": "F", "x": 324.0, "y": 189.9, "name": "F" },
          { "id": "D", "x": 251.0, "y": 6.0, "name": "D" }
        ],
        "polys": [
          ["A", "B", "C"],
          ["D", "E", "F"]
        ],
        "segs": [
          { "a": "A", "b": "B", "scale": "s", "text": "6", "draw": 6.0 },
          { "a": "B", "b": "C", "scale": "s" },
          { "a": "C", "b": "A", "scale": "s" },
          { "a": "D", "b": "E", "scale": "s", "text": "15", "draw": 15.0 },
          { "a": "E", "b": "F", "scale": "s" },
          { "a": "F", "b": "D", "scale": "s" }
        ],
        "angles": [
          { "at": "B", "a": "A", "b": "C", "arcs": 1 },
          { "at": "E", "a": "D", "b": "F", "arcs": 1 },
          { "at": "A", "a": "B", "b": "C", "arcs": 2 },
          { "at": "D", "a": "E", "b": "F", "arcs": 2 }
        ]
      },
      "answer": "5/2",
      "acceptable": ["2.5"],
      "check": "15 / 6",
      "hints": [
        "Scale factor from the first figure to the second = new length ÷ original length.",
        "AB and DE are corresponding sides. Divide DE by AB.",
        "Simplify 15/6."
      ],
      "solution": "Scale factor = DE ÷ AB = 15 ÷ 6<br>= 5/2 = <b>2.5</b>"
    },
