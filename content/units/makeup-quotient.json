      "choices": ["4x³", "6x³", "4x²", "6x²"],
      "answer": "4x³",
      "acceptable": [],
      "hints": [
        "Divide the numbers (don't subtract them): 8 ÷ 2.",
        "Subtract the exponents (don't divide them): 6 − 3.",
        "Common mistakes: 8 − 2 = 6 and 6 ÷ 3 = 2 are both wrong steps."
      ],
      "solution": "8 ÷ 2 = 4 and x⁶⁻³ = x³ → <b>4x³</b>"
    },
    {
      "id": "mq-p11",
      "type": "mcq",
      "prompt": "Simplify 10x⁴y² / (2x⁴y).",
