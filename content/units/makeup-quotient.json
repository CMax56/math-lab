{
  "id": "makeup-quotient",
  "title": "Prep: Laws of Exponents — Quotient Rule",
  "description": "Focused prep for the Laws of Exponents: Quotient Rule make-up quiz. Divide powers with the same base, get zero and negative exponents, and handle coefficients and more than one variable.",
  "strand": "makeup",
  "status": "starter",
  "related": ["exponent-rules"],
  "reference": {
    "title": "Quotient rule (from class)",
    "rows": [
      { "label": "Quotient rule", "rule": "x<sup>a</sup> / x<sup>b</sup> = x<sup>a−b</sup>" },
      { "label": "Zero exponent", "rule": "x<sup>0</sup> = 1", "note": "x ≠ 0" },
      { "label": "Negative exponent", "rule": "x<sup>−a</sup> = 1/x<sup>a</sup>" },
      { "label": "Power of a quotient", "rule": "(x/y)<sup>a</sup> = x<sup>a</sup>/y<sup>a</sup>" }
    ],
    "foot": "Divide the numbers in front. Subtract the exponents of each variable (top minus bottom)."
  },
  "practice": [
    {
      "id": "mq-p01",
      "type": "numeric",
      "prompt": "Quotient rule: x⁸ / x³ = xⁿ. What is n?",
      "figure": {
        "alt": "Eight x tiles over three x tiles, equals x to the n.",
        "chips": { "num": { "n": 8, "text": "x" }, "den": { "n": 3, "text": "x" }, "rhs": "xⁿ", "caption": "n = ?" }
      },
      "answer": "5",
      "acceptable": [],
      "check": "8 - 3",
      "hints": [
        "Quotient rule: x<sup>a</sup> / x<sup>b</sup> = x<sup>a−b</sup>.",
        "Each x on the bottom cancels one x on top.",
        "8 − 3 = ?"
      ],
      "solution": "x⁸ / x³ = x⁸⁻³ = x⁵, so n = <b>5</b>"
    },
    {
      "id": "mq-p02",
      "type": "numeric",
      "prompt": "Evaluate 3⁶ / 3⁴.",
      "figure": {
        "alt": "Six tiles of 3 over four tiles of 3.",
        "chips": { "num": { "n": 6, "text": "3" }, "den": { "n": 4, "text": "3" }, "rhs": "?" }
      },
      "answer": "9",
      "acceptable": [],
      "check": "3**6 / 3**4",
      "hints": ["Same base, dividing → subtract the exponents.", "6 − 4 = 2, so it's 3².", "3² = 9."],
      "solution": "3⁶ / 3⁴ = 3² = <b>9</b>"
    },
    {
      "id": "mq-p03",
      "type": "numeric",
      "prompt": "Evaluate 9³ / 9³.",
      "figure": {
        "alt": "Three tiles of 9 over three tiles of 9.",
        "chips": { "num": { "n": 3, "text": "9" }, "den": { "n": 3, "text": "9" }, "rhs": "?" }
      },
      "answer": "1",
      "acceptable": [],
      "check": "9**3 / 9**3",
      "hints": ["Subtract the exponents: 3 − 3 = 0.", "9⁰ = 1. (Anything nonzero over itself is 1.)"],
      "solution": "9³ / 9³ = 9⁰ = <b>1</b>"
    },
    {
      "id": "mq-p04",
      "type": "numeric",
      "prompt": "x³ / x⁷ = 1/xⁿ. What is n?",
