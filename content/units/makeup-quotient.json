    {
      "id": "mq-p05",
      "type": "numeric",
      "prompt": "Evaluate 2³ / 2⁶. Give a fraction or a decimal.",
      "figure": {
        "alt": "Three tiles of 2 over six tiles of 2.",
        "chips": { "num": { "n": 3, "text": "2" }, "den": { "n": 6, "text": "2" }, "rhs": "?" }
      },
      "answer": "1/8",
      "acceptable": ["0.125"],
      "check": "2**3 / 2**6",
