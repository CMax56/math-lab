        "polys": [["A", "B", "C"]],
        "segs": [{ "a": "A", "b": "B" }, { "a": "B", "b": "C" }, { "a": "C", "b": "A" }, { "a": "C", "b": "D" }],
        "angles": [
          { "at": "A", "a": "B", "b": "C", "text": "52°" },
