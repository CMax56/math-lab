    {
      "id": "tri-p05",
      "type": "numeric",
      "prompt": "DE is a midsegment of △ABC (parallel to BC). DE = 2x + 1 and BC = 5x − 4. Find x.",
      "figure": {
        "alt": "Triangle ABC with midsegment DE. DE is 2x + 1 and BC is 5x − 4.",
        "pts": [
          { "id": "A", "x": 107.2, "y": 6.0, "name": "A" },
          { "id": "B", "x": 6.0, "y": 208.4, "name": "B" },
          { "id": "C", "x": 324.0, "y": 208.4, "name": "C" },
          { "id": "D", "x": 56.6, "y": 107.2, "name": "D", "dot": true },
          { "id": "E", "x": 215.6, "y": 107.2, "name": "E", "dot": true }
        ],
        "polys": [["A", "B", "C"]],
        "segs": [
          { "a": "A", "b": "D", "ticks": 1 },
          { "a": "D", "b": "B", "ticks": 1 },
          { "a": "A", "b": "E", "ticks": 2 },
          { "a": "E", "b": "C", "ticks": 2 },
          { "a": "D", "b": "E", "text": "2x + 1", "arrows": 1 },
          { "a": "B", "b": "C", "text": "5x − 4", "arrows": 1 }
