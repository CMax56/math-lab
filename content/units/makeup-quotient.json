        "frac": { "num": "10x⁴y²", "den": "2x⁴y", "rhs": "?" }
      },
      "choices": ["5y", "5xy", "8y", "5x⁰"],
      "answer": "5y",
      "acceptable": [],
      "hints": ["10 ÷ 2 = 5.", "x⁴ / x⁴ = x⁰ = 1, so the x's disappear.", "y² / y¹ = y¹."],
      "solution": "10 ÷ 2 = 5, x⁴⁻⁴ = x⁰ = 1, y²⁻¹ = y → <b>5y</b>"
    }
